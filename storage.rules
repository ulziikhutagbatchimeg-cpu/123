rules_version = '2';

// The teacher account is the same as in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // The enrollment document is `${uid}_${course}` in Firestore, and it must be approved for the course in the path
    function isApproved(course) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/enrollments/$(request.auth.uid + '_' + course))
        && firestore.get(/databases/(default)/documents/enrollments/$(request.auth.uid + '_' + course)).data.status == 'approved';
    }

    // The protected course content (the lesson text and the slide pictures of each course). Only the teacher and the
    // students approved for that course read it, and only the teacher writes it.
    match /protected/{course}/{allPaths=**} {
      allow read: if isTeacher() || (course in ['igcse', 'as', 'a'] && isApproved(course));
      allow write: if isTeacher();
    }

    // The slide decks (.pptx), read and written only by the teacher account
    match /slides/{allPaths=**} {
      allow read, write: if isTeacher();
    }

    // The past-paper PDFs, under the same teacher-only rule
    match /papers/{allPaths=**} {
      allow read, write: if isTeacher();
    }
  }
}
