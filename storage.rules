rules_version = '2';

// The slide decks (.pptx) are read and written only by the teacher account. This is the same account as in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /slides/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // The slide pictures and manifest.json of each deck. Only signed-in users (students and the teacher) can view them,
    // and only the teacher uploads them. The .pptx files stay teacher-only.
    match /previews/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // The past-paper PDFs, under the same teacher-only rule
    match /papers/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
