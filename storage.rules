rules_version = '2';

// The slide decks (.pptx) are read and written only by the teacher account. This is the same account as in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /slides/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
