rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// The teacher email here must match VITE_TEACHER_EMAIL in .env.local.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /students/{studentId} {
      // A student reads and writes only their own document. The teacher reads all of them.
      allow read: if request.auth != null
        && (request.auth.uid == studentId || isTeacher());

      // The progress checklist, and the summary of the student's results (per programme)
      allow create, update: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['name', 'checks', 'completedTopics', 'updatedAt', 'results', 'resultsAt'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('checks' in request.resource.data) || request.resource.data.checks is map)
        && (!('completedTopics' in request.resource.data) || request.resource.data.completedTopics is list)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string)
        && (!('results' in request.resource.data) || request.resource.data.results is map)
        && (!('resultsAt' in request.resource.data) || request.resource.data.resultsAt is string);

      allow delete: if false;

      // One document per result: a lesson ticket, a game, the escape room, a question or a full test. The student writes
      // each result once, with the id the app gave it, and the teacher writes feedback on it. Students cannot change feedback.
      match /results/{resultId} {
        allow read: if request.auth != null
          && (request.auth.uid == studentId || isTeacher());

        allow create: if request.auth != null
          && request.auth.uid == studentId
          && request.resource.data.keys().hasOnly(['kind', 'course', 'takenAt', 'percent', 'label', 'questionId', 'topicId', 'paper', 'earned', 'max', 'testId'])
          && request.resource.data.kind in ['exit', 'game', 'escape', 'practice', 'question', 'test']
          && request.resource.data.course in ['igcse', 'as', 'a']
          && request.resource.data.takenAt is number
          && request.resource.data.percent is number
          && request.resource.data.percent >= 0
          && request.resource.data.percent <= 100;

        // The student may write the same result again (merge with the feedback kept), but change nothing in it
        allow update: if (request.auth != null
            && request.auth.uid == studentId
            && request.resource.data.diff(resource.data).affectedKeys().size() == 0)
          || (isTeacher()
            && resource.data.kind in ['exit', 'practice', 'question', 'test']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'feedbackAt'])
            && request.resource.data.feedback is string
            && request.resource.data.feedback.size() <= 500
            && request.resource.data.feedbackAt is string);

        allow delete: if false;
      }

      // The answers to the questions for each studied section. A student writes each one once, and cannot change it later.
      match /sectionSurveys/{topicId} {
        allow read: if request.auth != null
          && (request.auth.uid == studentId || isTeacher());

        allow create: if request.auth != null
          && request.auth.uid == studentId
          && request.resource.data.keys().hasOnly(['hardest', 'understood', 'selfStudy', 'text', 'liked', 'recommend', 'savedAt'])
          && request.resource.data.hardest is string
          && request.resource.data.hardest.size() <= 20
          && request.resource.data.liked is string
          && request.resource.data.liked.size() <= 20
          && request.resource.data.understood is number
          && request.resource.data.understood >= 1 && request.resource.data.understood <= 5
          && request.resource.data.selfStudy is number
          && request.resource.data.selfStudy >= 1 && request.resource.data.selfStudy <= 5
          && request.resource.data.recommend is number
          && request.resource.data.recommend >= 1 && request.resource.data.recommend <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && request.resource.data.savedAt is string;

        allow update, delete: if false;
      }

      // The student's notebook: the lessons pinned to it and the student's own notes. Only that student reads and writes them;
      // the teacher does not read them.
      match /notebook/{itemId} {
        allow read, delete: if request.auth != null && request.auth.uid == studentId;

        allow create, update: if request.auth != null
          && request.auth.uid == studentId
          && request.resource.data.keys().hasOnly(['kind', 'refKey', 'title', 'body', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['lesson', 'note']
          && request.resource.data.refKey is string
          && request.resource.data.refKey.size() <= 60
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }

      // The answers to a check, practice set or exit ticket, kept for the student's own account. Only that student reads and writes them.
      match /answers/{answerKey} {
        allow read: if request.auth != null && request.auth.uid == studentId;

        allow create, update: if request.auth != null
          && request.auth.uid == studentId
          && request.resource.data.keys().hasOnly(['value', 'savedAt'])
          && request.resource.data.value is string
          && request.resource.data.value.size() <= 60000
          && request.resource.data.savedAt is string;

        allow delete: if false;
      }
    }

    // Enrollment requests: a student asks to join one programme, and the teacher approves or rejects it.
    // The id is `${uid}_${programme}`, so a student can only read and write their own requests.
    match /enrollments/{enrollmentId} {
      // A student has one open programme at a time. Requested, approved and paused programmes count as open; a rejected one
      // does not. The other two programmes are checked by their ids, since rules cannot search the collection.
      function openIn(uid, programme) {
        return exists(/databases/$(database)/documents/enrollments/$(uid + '_' + programme))
          && get(/databases/$(database)/documents/enrollments/$(uid + '_' + programme)).data.status != 'rejected';
      }
      function openElsewhere(uid, programme) {
        return (programme != 'igcse' && openIn(uid, 'igcse'))
          || (programme != 'as' && openIn(uid, 'as'))
          || (programme != 'a' && openIn(uid, 'a'));
      }

      allow read: if (request.auth != null && enrollmentId.split('_')[0] == request.auth.uid) || isTeacher();

      // The teacher may create an enrollment with any of these statuses, so a student can be moved to another programme
      allow create: if isTeacher()
        && request.resource.data.programme in ['igcse', 'as', 'a']
        && enrollmentId == request.resource.data.uid + '_' + request.resource.data.programme
        && request.resource.data.status in ['requested', 'approved', 'suspended', 'rejected']
        && request.resource.data.access in ['gated', 'full']
        && request.resource.data.keys().hasOnly(['uid', 'programme', 'status', 'access', 'name', 'grade', 'track', 'requestedAt', 'decidedAt'])
        && request.resource.data.name is string;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.programme in ['igcse', 'as', 'a']
        && enrollmentId == request.auth.uid + '_' + request.resource.data.programme
        && request.resource.data.status == 'requested'
        && request.resource.data.access == 'gated'
        && request.resource.data.keys().hasOnly(['uid', 'programme', 'status', 'access', 'name', 'grade', 'requestedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.grade.matches('^(7|8|9|10|11|12)[A-D]$')
        && request.resource.data.requestedAt is string
        && !openElsewhere(request.auth.uid, request.resource.data.programme);

      // The teacher decides, and may set the access, the IGCSE track and a pause. A student may send the request again
      // only after a rejection, with their name and class; the track and the access stay the teacher's choice.
      allow update: if isTeacher()
        || (request.auth != null
          && enrollmentId.split('_')[0] == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.programme == resource.data.programme
          && request.resource.data.status == 'requested'
          && request.resource.data.access == 'gated'
          && request.resource.data.keys().hasOnly(['uid', 'programme', 'status', 'access', 'name', 'grade', 'requestedAt', 'decidedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.grade.matches('^(7|8|9|10|11|12)[A-D]$')
          && request.resource.data.requestedAt is string
          && !openElsewhere(request.auth.uid, request.resource.data.programme));

      // The teacher may remove an enrolment record for good. The student's results are kept elsewhere and are not touched.
      allow delete: if isTeacher();
    }

    // The two-minute site tour, kept in pieces here because Storage needs a billing account. Only the teacher writes it;
    // it is read by the teacher and by the students approved for the course (the 9701 courses share one copy).
    match /siteTour/{course}/{collection}/{docId} {
      function approvedFor(programme) {
        return request.auth != null
          && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + programme))
          && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + programme)).data.status == 'approved';
      }
      allow read: if isTeacher()
        || (course == 'igcse' && approvedFor('igcse'))
        || (course == 'alevel' && (approvedFor('as') || approvedFor('a')));
      allow write: if isTeacher();
    }

    // Notices from the teacher to the students of one programme. Only the teacher writes them. A student reads the notices of
    // the programme they are approved for; the teacher reads all. They never touch the results.
    match /notices/{noticeId} {
      function approvedFor(programme) {
        return request.auth != null
          && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + programme))
          && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + programme)).data.status == 'approved';
      }
      allow read: if isTeacher()
        || (resource.data.programme in ['igcse', 'as', 'a'] && approvedFor(resource.data.programme));
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['programme', 'title', 'body', 'createdAt'])
        && request.resource.data.programme in ['igcse', 'as', 'a']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 1000
        && request.resource.data.createdAt is string;
      allow update, delete: if isTeacher();
    }

    // The teacher reads the newest results of every student, in one list, for the teacher's bell. A student reads only their
    // own results (above). Results are read here, never written.
    match /{path=**}/results/{resultId} {
      allow read: if isTeacher();
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
