rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// The teacher email here must match VITE_TEACHER_EMAIL in .env.local.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'ulziikhutagbatchimeg@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /students/{studentId} {
      // A student reads and writes only their own document. The teacher reads all of them.
      allow read: if request.auth != null
        && (request.auth.uid == studentId || isTeacher());

      // The progress checklist, and the summary of the student's results (per programme)
      allow create, update: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['name', 'checks', 'completedTopics', 'updatedAt', 'results', 'resultsAt'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('checks' in request.resource.data) || request.resource.data.checks is map)
        && (!('completedTopics' in request.resource.data) || request.resource.data.completedTopics is list)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string)
        && (!('results' in request.resource.data) || request.resource.data.results is map)
        && (!('resultsAt' in request.resource.data) || request.resource.data.resultsAt is string);

      allow delete: if false;

      // One document per result: a lesson ticket, a game, the escape room, a question or a full test. The student writes
      // each result once, with the id the app gave it, and the teacher writes feedback on it. Students cannot change feedback.
      match /results/{resultId} {
        allow read: if request.auth != null
          && (request.auth.uid == studentId || isTeacher());

        allow create: if request.auth != null
          && request.auth.uid == studentId
          && request.resource.data.keys().hasOnly(['kind', 'course', 'takenAt', 'percent', 'label', 'questionId', 'topicId', 'paper', 'earned', 'max', 'testId'])
          && request.resource.data.kind in ['exit', 'game', 'escape', 'question', 'test']
          && request.resource.data.course in ['igcse', 'as', 'a']
          && request.resource.data.takenAt is number
          && request.resource.data.percent is number
          && request.resource.data.percent >= 0
          && request.resource.data.percent <= 100;

        // The student may write the same result again (merge with the feedback kept), but change nothing in it
        allow update: if (request.auth != null
            && request.auth.uid == studentId
            && request.resource.data.diff(resource.data).affectedKeys().size() == 0)
          || (isTeacher()
            && resource.data.kind in ['exit', 'question', 'test']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'feedbackAt'])
            && request.resource.data.feedback is string
            && request.resource.data.feedback.size() <= 500
            && request.resource.data.feedbackAt is string);

        allow delete: if false;
      }

      // The answers to the questions for each studied section. A student writes each one once, and cannot change it later.
      match /sectionSurveys/{topicId} {
        allow read: if request.auth != null
          && (request.auth.uid == studentId || isTeacher());

        allow create: if request.auth != null
          && request.auth.uid == studentId
          && request.resource.data.keys().hasOnly(['hardest', 'understood', 'selfStudy', 'text', 'liked', 'recommend', 'savedAt'])
          && request.resource.data.hardest is string
          && request.resource.data.hardest.size() <= 20
          && request.resource.data.liked is string
          && request.resource.data.liked.size() <= 20
          && request.resource.data.understood is number
          && request.resource.data.understood >= 1 && request.resource.data.understood <= 5
          && request.resource.data.selfStudy is number
          && request.resource.data.selfStudy >= 1 && request.resource.data.selfStudy <= 5
          && request.resource.data.recommend is number
          && request.resource.data.recommend >= 1 && request.resource.data.recommend <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && request.resource.data.savedAt is string;

        allow update, delete: if false;
      }
    }

    // Enrollment requests: a student asks to join one programme, and the teacher approves or rejects it.
    // The id is `${uid}_${programme}`, so a student can only read and write their own requests.
    match /enrollments/{enrollmentId} {
      allow read: if (request.auth != null && enrollmentId.split('_')[0] == request.auth.uid) || isTeacher();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.programme in ['igcse', 'as', 'a']
        && enrollmentId == request.auth.uid + '_' + request.resource.data.programme
        && request.resource.data.status == 'requested'
        && request.resource.data.access == 'gated'
        && request.resource.data.keys().hasOnly(['uid', 'programme', 'status', 'access', 'name', 'requestedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.requestedAt is string;

      // The teacher decides. A student may send the request again only after a rejection.
      allow update: if isTeacher()
        || (request.auth != null
          && enrollmentId.split('_')[0] == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.programme == resource.data.programme
          && request.resource.data.status == 'requested'
          && request.resource.data.access == 'gated'
          && request.resource.data.keys().hasOnly(['uid', 'programme', 'status', 'access', 'name', 'requestedAt', 'decidedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.requestedAt is string);

      allow delete: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
